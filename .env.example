# Inject secrets through your deployment platform. Generate a fresh encryption key.
HOST=127.0.0.1
PORT=3000
EPMS_DB_PATH=data/platform-v2.sqlite
EPMS_DATA_KEY=
EPMS_PUBLIC_ORIGIN=
EPMS_SECURE_COOKIE=1
EPMS_ADMIN_EMAIL=
EPMS_ADMIN_NAME=
EPMS_ADMIN_PASSWORD=
EPMS_ROSTER_TOKEN=
EPMS_NOTIFICATION_TOKEN=
EPMS_SSO_PUBLIC_KEY_FILE=
EPMS_SSO_ISSUER=
EPMS_SSO_AUDIENCE=
EPMS_SSO_URL=
EPMS_BACKUP_PATH=

EPMS_STAGE=staging
EPMS_ENVIRONMENT=
EPMS_SCAN_TOKEN=
EPMS_LOCAL_LOGIN=on
EPMS_ADMIN_SUBJECT=
# Comma-separated exact transport peer IPs. Restrict gateway forwarding separately.
EPMS_INTEGRATION_IPS=
# Independent 32-byte base64 wrapping key. Supply from the secret manager on every instance.
EPMS_FEEDBACK_KEY=
